{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".*",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite v\\d+",
          "endsPattern": "ready in .*"
        }
      }
    }
  ]
}
